<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Min Personliga Hemsida</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background: url('https://source.unsplash.com/1600x900/?forest,road') no-repeat center center fixed;
            background-size: cover;
            color: white;
            text-align: center;
        }
        header {
            background: rgba(0, 0, 0, 0.7);
            padding: 20px;
            font-size: 24px;
        }
        .container {
            padding: 40px;
            background: rgba(0, 0, 0, 0.6);
            margin: 50px auto;
            max-width: 800px;
            border-radius: 10px;
        }
        .button {
            display: inline-block;
            margin: 10px;
            padding: 10px 20px;
            background: #ffcc00;
            color: black;
            text-decoration: none;
            border-radius: 5px;
        }
        .gallery {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            margin-top: 20px;
        }
        .gallery img {
            width: 250px;
            height: 150px;
            object-fit: cover;
            margin: 10px;
            border-radius: 10px;
            transition: transform 0.3s;
        }
        .gallery img:hover {
            transform: scale(1.1);
        }
        .weather-box {
            margin-top: 20px;
            padding: 20px;
            background: rgba(0, 0, 0, 0.7);
            border-radius: 10px;
            display: inline-block;
        }
        footer {
            margin-top: 20px;
            background: rgba(0, 0, 0, 0.7);
            padding: 10px;
        }
    </style>
    <script>
        async function getWeather() {
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(async position => {
                    const lat = position.coords.latitude;
                    const lon = position.coords.longitude;
                    const apiUrl = `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current=temperature_2m,wind_speed_10m`;
                    
                    try {
                        const response = await fetch(apiUrl);
                        const data = await response.json();
                        document.getElementById('weather').innerHTML = `
                            <h3>Lokalt väder</h3>
                            <p>Temperatur: ${data.current.temperature_2m}°C</p>
                            <p>Vindhastighet: ${data.current.wind_speed_10m} m/s</p>
                        `;
                    } catch (error) {
                        console.error("Fel vid hämtning av väderdata", error);
                    }
                });
            }
        }
    </script>
</head>
<body onload="getWeather()">
    <header>
        <h1>Välkommen till min värld</h1>
    </header>
    <div class="container">
        <h2>Teknik, Natur & Bussar</h2>
        <p>Jag älskar teknikens framsteg, den svenska naturens skönhet och passionen för bussar.</p>
        <a href="#" class="button">Läs mer om teknik</a>
        <a href="#" class="button">Utforska naturen</a>
        <a href="#" class="button">Se mina favoritbussar</a>
        <div class="gallery">
            <img src="https://source.unsplash.com/250x150/?technology" alt="Teknik">
            <img src="https://source.unsplash.com/250x150/?swedish-nature" alt="Svensk natur">
            <img src="https://source.unsplash.com/250x150/?bus" alt="Buss">
        </div>
        <div id="weather" class="weather-box">
            <h3>Hämtar väder...</h3>
        </div>
    </div>
    <footer>
        <p>&copy; 2025 Min Personliga Hemsida</p>
    </footer>
</body>
</html>
